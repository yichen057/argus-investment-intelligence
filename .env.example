# Copy to .env for local Docker Compose use. Never commit the real API key.
ARGUS_ENABLE_CLOUD_SERVICES=false
ARGUS_MODEL_PROVIDER=auto

# Shared by Gemini, DeepSeek, and Kimi model requests.
ARGUS_MODEL_TIMEOUT_MS=20000
ARGUS_MODEL_MAX_ATTEMPTS=3
ARGUS_MODEL_RETRY_BACKOFF_MS=100

# Grounded market search needs a longer response window. Keep attempts at 1 to
# avoid repeating a provider search that may already have incurred a tool fee.
ARGUS_MARKET_ANALYSIS_TIMEOUT_MS=60000
ARGUS_MARKET_ANALYSIS_MAX_ATTEMPTS=1
ARGUS_MARKET_ANALYSIS_MAX_OUTPUT_TOKENS=1600
# Keep only bounded structured Portfolio market-analysis traces. Full prompts,
# full web pages, account names, dollar holdings, and API keys are never stored.
ARGUS_MARKET_ANALYSIS_TRACE_RETENTION_COUNT=50
ARGUS_MARKET_ANALYSIS_TRACE_RETENTION_DAYS=30
# deterministic (default) fixes ETF eligibility/score/rank before model explanation.
# model is the explicit legacy rollback path; restart the API after changing it.
ARGUS_ETF_SELECTION_ENGINE=deterministic

# Portfolio and market-data sources. External access is independently disabled
# by default even when model cloud services are enabled.
ARGUS_ENABLE_EXTERNAL_MARKET_DATA=false
ARGUS_ENABLE_ROBINHOOD=false
# Optional fixed-size sector/industry matrix. When false, Portfolio keeps the
# compact market-data status card used before the Heatmap was introduced.
ARGUS_ENABLE_MARKET_HEATMAP=false
# Unified Market/Research ETF Universe. Set false to restore the prior separate
# Heatmap and Sector/industry ETF candidate directory during rollout.
ARGUS_ENABLE_UNIFIED_ETF_UNIVERSE=false
# Local Sidecar credentials are separate from Robinhood OAuth. Never put a
# Robinhood access/refresh token, password, Cookie, or callback code in .env.
ARGUS_ROBINHOOD_SIDECAR_URL=http://host.docker.internal:8765
ARGUS_ROBINHOOD_SIDECAR_TOKEN=
# Set only after reviewing artifacts/robinhood-capability-audit.json.
ARGUS_ROBINHOOD_APPROVED_MANIFEST=
# Optional read-only OHLCV. Keep false unless the Sidecar has been restarted
# with the approved historicals contract and you want volume-activity metrics.
ARGUS_ROBINHOOD_ENABLE_HISTORICALS=false
# 01=Robinhood, 02=Twelve Data, 03=Alpha Vantage, 04=Massive.
# Argus never silently switches to a different external provider. If the selected
# adapter is disabled, disconnected, or fails, uploaded prices remain Not live.
ARGUS_MARKET_DATA_PROVIDER=01

# Optional Kafka audit/metrics stream. Redis remains the operational job queue.
# The consumer stores only a bounded, sanitized projection in Runs Management.
ARGUS_KAFKA_BOOTSTRAP_SERVERS=
ARGUS_KAFKA_CLIENT_ID=argus
ARGUS_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
ARGUS_KAFKA_SASL_MECHANISM=
ARGUS_KAFKA_CONSUMER_GROUP=argus-audit-metrics-v1
ARGUS_KAFKA_CONSUMER_MAX_ATTEMPTS=3
ARGUS_KAFKA_CONSUMER_RETRY_BACKOFF_MS=100
ARGUS_KAFKA_CONSUMER_POLL_TIMEOUT_MS=1000
ARGUS_KAFKA_CONSUMER_STALE_AFTER_SECONDS=15
ARGUS_KAFKA_AUDIT_RETENTION_COUNT=5000
ARGUS_KAFKA_AUDIT_RETENTION_DAYS=30

# Gemini
ARGUS_GEMINI_API_KEY=
ARGUS_GEMINI_MODEL=gemini-3.1-flash-lite
ARGUS_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
ARGUS_GEMINI_EMBEDDING_DIMENSIONS=768
ARGUS_GEMINI_INPUT_COST_PER_MILLION=0.25
ARGUS_GEMINI_OUTPUT_COST_PER_MILLION=1.50

# DeepSeek
ARGUS_DEEPSEEK_API_KEY=
ARGUS_DEEPSEEK_MODEL=deepseek-v4-flash
ARGUS_DEEPSEEK_BASE_URL=https://api.deepseek.com
ARGUS_DEEPSEEK_INPUT_COST_PER_MILLION=0.14
ARGUS_DEEPSEEK_OUTPUT_COST_PER_MILLION=0.28
ARGUS_DEEPSEEK_PRO_MODEL=deepseek-v4-pro
ARGUS_DEEPSEEK_PRO_INPUT_COST_PER_MILLION=0.435
ARGUS_DEEPSEEK_PRO_OUTPUT_COST_PER_MILLION=0.87

# Kimi
ARGUS_KIMI_API_KEY=
ARGUS_KIMI_MODEL=kimi-k2.6
ARGUS_KIMI_BASE_URL=https://api.moonshot.ai/v1
# Kimi K2.6 can take longer to synthesize grounded multi-source answers. This
# provider-only window avoids discarding a response just after the shared 20s
# limit; timeouts are not automatically retried because the first call may bill.
ARGUS_KIMI_TIMEOUT_MS=60000
ARGUS_KIMI_INPUT_COST_PER_MILLION=0.95
ARGUS_KIMI_OUTPUT_COST_PER_MILLION=4.00
# Keep blank until Moonshot's /models endpoint confirms the exact Kimi K3 ID.
ARGUS_KIMI_CANDIDATE_MODEL=
ARGUS_KIMI_CANDIDATE_INPUT_COST_PER_MILLION=0
ARGUS_KIMI_CANDIDATE_OUTPUT_COST_PER_MILLION=0

# OpenAI API billing is separate from a ChatGPT subscription. GPT-5.5 is an
# explicit benchmark candidate; Argus never uses it as a hidden fallback.
ARGUS_OPENAI_API_KEY=
ARGUS_OPENAI_MODEL=gpt-5.5
ARGUS_OPENAI_BASE_URL=https://api.openai.com/v1
ARGUS_OPENAI_INPUT_COST_PER_MILLION=5.0
ARGUS_OPENAI_OUTPUT_COST_PER_MILLION=30.0
ARGUS_MODEL_BENCHMARK_MAX_COST_USD=0.10

# Independent web search and evidence retrieval. Exa is not an answer model.
ARGUS_EXA_API_KEY=
ARGUS_EXA_BASE_URL=https://api.exa.ai
ARGUS_EXA_SEARCH_TYPE=auto
ARGUS_EXA_TIMEOUT_MS=15000
ARGUS_EXA_MAX_RESULTS=8
ARGUS_EXA_HIGHLIGHT_MAX_CHARACTERS=2000
ARGUS_EXA_SEARCH_COST_PER_REQUEST=0.007
ARGUS_WEB_SEARCH_MAX_CALLS=2

# Local research tools use a separate retry policy.
ARGUS_TOOL_TIMEOUT_MS=10000
ARGUS_TOOL_MAX_ATTEMPTS=3
ARGUS_TOOL_RETRY_BACKOFF_MS=100

# Resource-bounded document ingestion. The API streams uploads and an isolated
# child parser is stopped with a user-visible reason if any bound is exceeded.
ARGUS_DOCUMENT_UPLOAD_MAX_BYTES=26214400
ARGUS_DOCUMENT_PDF_MAX_PAGES=500
ARGUS_DOCUMENT_EXTRACTED_TEXT_MAX_CHARACTERS=2000000
ARGUS_DOCUMENT_EXTRACTION_TIMEOUT_SECONDS=90
ARGUS_DOCUMENT_EXTRACTION_WARNING_RSS_BYTES=1073741824
ARGUS_DOCUMENT_EXTRACTION_MAX_RSS_BYTES=1610612736
ARGUS_DOCUMENT_RESOURCE_POLL_INTERVAL_MS=500
ARGUS_DOCUMENT_RESOURCE_TERMINATE_GRACE_SECONDS=5
ARGUS_DOCUMENT_ADMISSION_MEMORY_RATIO=0.70
# Base Compose maps this managed directory to ./data/uploads on the host.
ARGUS_DOCUMENT_UPLOAD_ROOT=/app/data/uploads

# V2 local overlay defaults. Cloud values come from Secrets Manager/config.
ARGUS_REDIS_URL=
ARGUS_KAFKA_BOOTSTRAP_SERVERS=
ARGUS_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
ARGUS_KAFKA_SASL_MECHANISM=
ARGUS_S3_BUCKET=
ARGUS_S3_PREFIX=argus
AWS_REGION=us-west-2
OTEL_EXPORTER_OTLP_ENDPOINT=
